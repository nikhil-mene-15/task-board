{
  "name": "task-board",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "migrate": "npm run migrate --prefix server",
    "seed": "npm run seed --prefix server --",
    "consolidate": "npm run consolidate --prefix server",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6"
  },
  "type": "module"
}
